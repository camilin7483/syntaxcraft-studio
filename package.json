{
  "name": "syntaxcraft-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Original color and icon themes, native code organization, and portable appearance profiles for Visual Studio Code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/unit.mjs",
    "test:integration": "node scripts/integration.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "@vscode/vsce": {
      "minimatch": "^11.0.9"
    }
  }
}
