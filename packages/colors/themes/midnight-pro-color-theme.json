    "terminal.selectionBackground": "#31456E",
    "terminalCursor.foreground": "#8CABFF",
    "terminalCursor.background": "#10182C",
    "terminal.ansiBlack": "#1B2434",
    "terminal.ansiRed": "#FF949C",
    "terminal.ansiGreen": "#91D6A1",
    "terminal.ansiYellow": "#F9CA77",
    "terminal.ansiBlue": "#8BCBFF",
    "terminal.ansiMagenta": "#C2A8FF",
    "terminal.ansiCyan": "#85DFD1",
    "terminal.ansiWhite": "#DCE7F8",
    "terminal.ansiBrightBlack": "#94A5C1",
    "terminal.ansiBrightRed": "#F1AAF0",
    "terminal.ansiBrightGreen": "#A6D9A1",
    "terminal.ansiBrightYellow": "#FFD08C",
    "terminal.ansiBrightBlue": "#8ED6FF",
    "terminal.ansiBrightMagenta": "#A9C7FF",
    "terminal.ansiBrightCyan": "#9AD3FF",
    "terminal.ansiBrightWhite": "#DCE7F8"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#94A5C1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Quoted text",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A6D9A1"
      }
    },
    {
      "name": "Escapes and interpolations",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#FFD08C"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFBA99"
      }
    },
    {
      "name": "Boolean and null literals",
      "scope": [
        "constant.language",
        "constant.other.null"
      ],
      "settings": {
        "foreground": "#FFBA99"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C2A8FF"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DCE7F8",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.other.import",
        "keyword.control.from",
        "keyword.control.require",
        "keyword.other.use"
      ],
      "settings": {
        "foreground": "#C2A8FF"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#C2D8FF"
      }
    },
    {
      "name": "Read-only names and constants",
      "scope": [
        "variable.other.constant",
        "constant.other.symbol",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFD08C"
      }
    },
    {
      "name": "Parameters and named arguments",
      "scope": [
        "variable.parameter",
        "variable.other.parameter",
        "variable.argument"
      ],
      "settings": {
        "foreground": "#FFD08C"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFD08C"
      }
    },
    {
      "name": "Function declarations and calls",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.variable entity.name.function",
        "meta.function entity.name.function",
        "meta.function-call entity.name.function",
        "meta.function-call support.function",
        "meta.function-call variable.function",
        "meta.function.definition.rust entity.name.function.rust",
        "meta.function.call.rust entity.name.function.rust",
        "meta.function-call.generic.python",
        "entity.name.function.support.go",
        "entity.name.function.definition",
        "entity.name.function.call"
      ],
      "settings": {
        "foreground": "#8ED6FF"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "meta.definition.method entity.name.function",
        "meta.method.declaration entity.name.function",
        "meta.method.identifier.java entity.name.function.java",
        "meta.method-call.java entity.name.function.java",
        "meta.function.method.with-arguments.ruby entity.name.function.ruby",
        "meta.function.method.without-arguments.ruby entity.name.function.ruby",
        "entity.name.function.member",
        "entity.name.function.method",
        "support.function.method"
      ],
      "settings": {
        "foreground": "#A9C7FF"
      }
    },
    {
      "name": "Types, interfaces and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#85DFD1"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#85DFD1"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "storage.type.annotation",
        "storage.type.annotation entity.name.type",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F1AAF0"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "string.regex"
      ],
      "settings": {
        "foreground": "#FFC59F"
      }
    },
    {
      "name": "Tag names",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F1AAF0"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#94A5C1"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "meta.tag entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#FFD08C"
      }
    },
    {
      "name": "Style selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element",
        "entity.name.tag.css",
        "entity.name.tag.scss",
        "entity.name.tag.less"
      ],
      "settings": {
        "foreground": "#9AD3FF"
      }
    },
    {
      "name": "Style values",
      "scope": [
        "support.constant.property-value",
        "constant.other.color",
        "support.constant.font-name",
        "support.constant.color",
        "constant.numeric.suffix"
      ],
      "settings": {
        "foreground": "#A6D9A1"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#85DFD1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DCE7F8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DCE7F8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown deleted text",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#94A5C1",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8CABFF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF949C",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#85DFD1",
    "type": "#85DFD1",
    "class": "#85DFD1",
    "enum": "#85DFD1",
    "interface": "#85DFD1",
    "struct": "#85DFD1",
    "typeParameter": "#85DFD1",
    "parameter": "#FFD08C",
    "property": "#FFD08C",
    "enumMember": "#FFD08C",
    "variable.readonly": "#FFD08C",
    "function.declaration": "#8ED6FF",
    "method": "#A9C7FF",
    "macro": "#8ED6FF",
    "decorator": "#F1AAF0"
  }
}
