    "editorSuggestWidget.border": "#303B51",
    "editorSuggestWidget.selectedBackground": "#31456E",
    "editorSuggestWidget.highlightForeground": "#8CABFF",
    "editorInlayHint.background": "#1B2434",
    "editorInlayHint.foreground": "#94A5C1",
    "editorGutter.addedBackground": "#91D6A1",
    "editorGutter.modifiedBackground": "#8BCBFF",
    "editorGutter.deletedBackground": "#FF949C",
    "editorOverviewRuler.addedForeground": "#91D6A199",
    "editorOverviewRuler.modifiedForeground": "#8BCBFF99",
    "editorOverviewRuler.deletedForeground": "#FF949C99",
    "editorOverviewRuler.errorForeground": "#FF949C",
    "editorOverviewRuler.warningForeground": "#F9CA77",
    "minimap.selectionHighlight": "#31456E",
    "minimapGutter.addedBackground": "#91D6A1",
    "minimapGutter.modifiedBackground": "#8BCBFF",
    "minimapGutter.deletedBackground": "#FF949C",
    "diffEditor.insertedTextBackground": "#91D6A13B",
    "diffEditor.removedTextBackground": "#FF949C37",
    "diffEditor.insertedLineBackground": "#91D6A11E",
    "diffEditor.removedLineBackground": "#FF949C12",
    "diffEditor.diagonalFill": "#303B51",
    "diffEditor.border": "#303B51",
    "gitDecoration.addedResourceForeground": "#91D6A1",
    "gitDecoration.modifiedResourceForeground": "#8BCBFF",
    "gitDecoration.deletedResourceForeground": "#FF949C",
    "gitDecoration.renamedResourceForeground": "#85DFD1",
