    "editorBracketHighlight.foreground5": "#F4D083",
    "editorBracketHighlight.foreground6": "#B8D6A0",
    "editorBracketHighlight.unexpectedBracket.foreground": "#F4A1A6",
    "editorWhitespace.foreground": "#A6ACB855",
    "editorCodeLens.foreground": "#A6ACB8",
    "editorLink.activeForeground": "#EAC28C",
    "editorError.foreground": "#F4A1A6",
    "editorWarning.foreground": "#F4D083",
    "editorInfo.foreground": "#A5CFF1",
    "editorHint.foreground": "#A6ACB8",
    "editorWidget.background": "#282B30",
    "editorWidget.foreground": "#E8E7E4",
    "editorWidget.border": "#41464E",
    "editorHoverWidget.background": "#282B30",
    "editorHoverWidget.foreground": "#E8E7E4",
    "editorHoverWidget.border": "#41464E",
    "editorSuggestWidget.background": "#282B30",
    "editorSuggestWidget.foreground": "#E8E7E4",
    "editorSuggestWidget.border": "#41464E",
    "editorSuggestWidget.selectedBackground": "#3D422F",
    "editorSuggestWidget.highlightForeground": "#EAC28C",
    "editorInlayHint.background": "#282B30",
    "editorInlayHint.foreground": "#A6ACB8",
    "editorGutter.addedBackground": "#A6D4A7",
    "editorGutter.modifiedBackground": "#A5CFF1",
    "editorGutter.deletedBackground": "#F4A1A6",
    "editorOverviewRuler.addedForeground": "#A6D4A799",
    "editorOverviewRuler.modifiedForeground": "#A5CFF199",
    "editorOverviewRuler.deletedForeground": "#F4A1A699",
    "editorOverviewRuler.errorForeground": "#F4A1A6",
    "editorOverviewRuler.warningForeground": "#F4D083",
    "minimap.selectionHighlight": "#3D422F",
    "minimapGutter.addedBackground": "#A6D4A7",
    "minimapGutter.modifiedBackground": "#A5CFF1",
    "minimapGutter.deletedBackground": "#F4A1A6",
    "diffEditor.insertedTextBackground": "#A6D4A73B",
    "diffEditor.removedTextBackground": "#F4A1A637",
    "diffEditor.insertedLineBackground": "#A6D4A71E",
    "diffEditor.removedLineBackground": "#F4A1A612",
    "diffEditor.diagonalFill": "#41464E",
    "diffEditor.border": "#41464E",
    "gitDecoration.addedResourceForeground": "#A6D4A7",
    "gitDecoration.modifiedResourceForeground": "#A5CFF1",
    "gitDecoration.deletedResourceForeground": "#F4A1A6",
    "gitDecoration.renamedResourceForeground": "#A9DDD5",
    "gitDecoration.untrackedResourceForeground": "#A6D4A7",
    "gitDecoration.ignoredResourceForeground": "#A6ACB8",
    "gitDecoration.conflictingResourceForeground": "#F4D083",
    "gitDecoration.stageModifiedResourceForeground": "#A5CFF1",
    "gitDecoration.stageDeletedResourceForeground": "#F4A1A6",
    "gitDecoration.submoduleResourceForeground": "#D5BBF2",
    "terminal.background": "#202226",
    "terminal.foreground": "#E8E7E4",
    "terminal.border": "#41464E",
    "terminal.selectionBackground": "#3D422F",
    "terminalCursor.foreground": "#EAC28C",
    "terminalCursor.background": "#2B2015",
    "terminal.ansiBlack": "#282B30",
    "terminal.ansiRed": "#F4A1A6",
    "terminal.ansiGreen": "#A6D4A7",
    "terminal.ansiYellow": "#F4D083",
    "terminal.ansiBlue": "#A5CFF1",
    "terminal.ansiMagenta": "#D5BBF2",
    "terminal.ansiCyan": "#A9DDD5",
    "terminal.ansiWhite": "#E8E7E4",
    "terminal.ansiBrightBlack": "#A6ACB8",
    "terminal.ansiBrightRed": "#E6B1D3",
    "terminal.ansiBrightGreen": "#B8D6A0",
    "terminal.ansiBrightYellow": "#EFCA8F",
    "terminal.ansiBrightBlue": "#A2DAD6",
    "terminal.ansiBrightMagenta": "#B8CDF0",
    "terminal.ansiBrightCyan": "#B3D5F0",
    "terminal.ansiBrightWhite": "#E8E7E4"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#A6ACB8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Quoted text",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#B8D6A0"
      }
    },
    {
      "name": "Escapes and interpolations",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#EFCA8F"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F0B395"
      }
    },
    {
      "name": "Boolean and null literals",
      "scope": [
        "constant.language",
        "constant.other.null"
      ],
      "settings": {
        "foreground": "#F0B395"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D5BBF2"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E8E7E4",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.other.import",
        "keyword.control.from",
        "keyword.control.require",
        "keyword.other.use"
      ],
      "settings": {
        "foreground": "#D5BBF2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#D9DEE9"
      }
    },
    {
      "name": "Read-only names and constants",
      "scope": [
        "variable.other.constant",
        "constant.other.symbol",
        "support.constant"
      ],
      "settings": {
        "foreground": "#EFCA8F"
      }
    },
    {
      "name": "Parameters and named arguments",
      "scope": [
        "variable.parameter",
        "variable.other.parameter",
        "variable.argument"
      ],
      "settings": {
        "foreground": "#EFCA8F"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#EFCA8F"
      }
    },
    {
      "name": "Function declarations and calls",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.variable entity.name.function",
        "meta.function entity.name.function",
        "meta.function-call entity.name.function",
        "meta.function-call support.function",
        "meta.function-call variable.function",
        "meta.function.definition.rust entity.name.function.rust",
        "meta.function.call.rust entity.name.function.rust",
        "meta.function-call.generic.python",
        "entity.name.function.support.go",
        "entity.name.function.definition",
        "entity.name.function.call"
      ],
      "settings": {
        "foreground": "#A2DAD6"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "meta.definition.method entity.name.function",
        "meta.method.declaration entity.name.function",
        "meta.method.identifier.java entity.name.function.java",
        "meta.method-call.java entity.name.function.java",
        "meta.function.method.with-arguments.ruby entity.name.function.ruby",
        "meta.function.method.without-arguments.ruby entity.name.function.ruby",
        "entity.name.function.member",
        "entity.name.function.method",
        "support.function.method"
      ],
      "settings": {
        "foreground": "#B8CDF0"
      }
    },
    {
      "name": "Types, interfaces and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#A9DDD5"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#A9DDD5"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "storage.type.annotation",
        "storage.type.annotation entity.name.type",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#E6B1D3"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "string.regex"
      ],
      "settings": {
        "foreground": "#EBD596"
      }
    },
    {
      "name": "Tag names",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E6B1D3"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A6ACB8"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "meta.tag entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#EFCA8F"
      }
    },
    {
      "name": "Style selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element",
        "entity.name.tag.css",
        "entity.name.tag.scss",
        "entity.name.tag.less"
      ],
      "settings": {
        "foreground": "#B3D5F0"
      }
    },
    {
      "name": "Style values",
      "scope": [
        "support.constant.property-value",
        "constant.other.color",
        "support.constant.font-name",
        "support.constant.color",
        "constant.numeric.suffix"
      ],
      "settings": {
        "foreground": "#B8D6A0"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A9DDD5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E8E7E4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E8E7E4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown deleted text",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#A6ACB8",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#EAC28C",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F4A1A6",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#A9DDD5",
    "type": "#A9DDD5",
    "class": "#A9DDD5",
    "enum": "#A9DDD5",
    "interface": "#A9DDD5",
    "struct": "#A9DDD5",
    "typeParameter": "#A9DDD5",
    "parameter": "#EFCA8F",
    "property": "#EFCA8F",
    "enumMember": "#EFCA8F",
    "variable.readonly": "#EFCA8F",
    "function.declaration": "#A2DAD6",
    "method": "#B8CDF0",
    "macro": "#A2DAD6",
    "decorator": "#E6B1D3"
  }
}
