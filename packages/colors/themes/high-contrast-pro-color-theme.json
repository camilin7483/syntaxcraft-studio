    "editorHoverWidget.foreground": "#F3F7FF",
    "editorHoverWidget.border": "#72859E",
    "editorSuggestWidget.background": "#151F2C",
    "editorSuggestWidget.foreground": "#F3F7FF",
    "editorSuggestWidget.border": "#72859E",
    "editorSuggestWidget.selectedBackground": "#223D5E",
    "editorSuggestWidget.highlightForeground": "#FFF28A",
    "editorInlayHint.background": "#151F2C",
    "editorInlayHint.foreground": "#BDCDDF",
    "editorGutter.addedBackground": "#ABFFA6",
    "editorGutter.modifiedBackground": "#8BE5FF",
    "editorGutter.deletedBackground": "#FFA3AC",
    "editorOverviewRuler.addedForeground": "#ABFFA699",
    "editorOverviewRuler.modifiedForeground": "#8BE5FF99",
    "editorOverviewRuler.deletedForeground": "#FFA3AC99",
    "editorOverviewRuler.errorForeground": "#FFA3AC",
    "editorOverviewRuler.warningForeground": "#FFF389",
    "minimap.selectionHighlight": "#223D5E",
    "minimapGutter.addedBackground": "#ABFFA6",
    "minimapGutter.modifiedBackground": "#8BE5FF",
    "minimapGutter.deletedBackground": "#FFA3AC",
    "diffEditor.insertedTextBackground": "#ABFFA63B",
    "diffEditor.removedTextBackground": "#FFA3AC37",
    "diffEditor.insertedLineBackground": "#ABFFA61E",
    "diffEditor.removedLineBackground": "#FFA3AC12",
    "diffEditor.diagonalFill": "#72859E",
    "diffEditor.border": "#72859E",
    "gitDecoration.addedResourceForeground": "#ABFFA6",
    "gitDecoration.modifiedResourceForeground": "#8BE5FF",
    "gitDecoration.deletedResourceForeground": "#FFA3AC",
    "gitDecoration.renamedResourceForeground": "#8AFFDF",
    "gitDecoration.untrackedResourceForeground": "#ABFFA6",
    "gitDecoration.ignoredResourceForeground": "#BDCDDF",
    "gitDecoration.conflictingResourceForeground": "#FFF389",
    "gitDecoration.stageModifiedResourceForeground": "#8BE5FF",
    "gitDecoration.stageDeletedResourceForeground": "#FFA3AC",
