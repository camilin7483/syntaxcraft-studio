    "terminal.background": "#0C111A",
    "terminal.foreground": "#F3F7FF",
    "terminal.border": "#72859E",
    "terminal.selectionBackground": "#223D5E",
    "terminalCursor.foreground": "#FFF28A",
    "terminalCursor.background": "#12151D",
    "terminal.ansiBlack": "#151F2C",
    "terminal.ansiRed": "#FFA3AC",
    "terminal.ansiGreen": "#ABFFA6",
    "terminal.ansiYellow": "#FFF389",
    "terminal.ansiBlue": "#8BE5FF",
    "terminal.ansiMagenta": "#FFB4FF",
    "terminal.ansiCyan": "#8AFFDF",
    "terminal.ansiWhite": "#F3F7FF",
    "terminal.ansiBrightBlack": "#BDCDDF",
    "terminal.ansiBrightRed": "#FFAACD",
    "terminal.ansiBrightGreen": "#AEFFAB",
    "terminal.ansiBrightYellow": "#FFF384",
    "terminal.ansiBrightBlue": "#85EBFF",
    "terminal.ansiBrightMagenta": "#AEC5FF",
    "terminal.ansiBrightCyan": "#B9B0FF",
    "terminal.ansiBrightWhite": "#F3F7FF",
    "contrastBorder": "#72859E",
    "contrastActiveBorder": "#FFF28A",
    "editor.selectionHighlightBorder": "#FFF28A",
    "editor.findMatchHighlightBorder": "#FFF389",
    "diffEditor.insertedTextBorder": "#ABFFA6",
    "diffEditor.removedTextBorder": "#FFA3AC"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#BDCDDF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Quoted text",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#AEFFAB"
      }
    },
    {
      "name": "Escapes and interpolations",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#FFF384"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFD19A"
      }
    },
    {
      "name": "Boolean and null literals",
      "scope": [
        "constant.language",
        "constant.other.null"
      ],
      "settings": {
        "foreground": "#FFD19A"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFB4FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F3F7FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.other.import",
        "keyword.control.from",
        "keyword.control.require",
        "keyword.other.use"
      ],
      "settings": {
        "foreground": "#FFB4FF"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#E3F1FF"
      }
    },
    {
      "name": "Read-only names and constants",
      "scope": [
        "variable.other.constant",
        "constant.other.symbol",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFF384"
      }
    },
    {
      "name": "Parameters and named arguments",
      "scope": [
        "variable.parameter",
        "variable.other.parameter",
        "variable.argument"
      ],
      "settings": {
        "foreground": "#FFF384"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFF384"
      }
    },
    {
      "name": "Function declarations and calls",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.variable entity.name.function",
        "meta.function entity.name.function",
        "meta.function-call entity.name.function",
        "meta.function-call support.function",
        "meta.function-call variable.function",
        "meta.function.definition.rust entity.name.function.rust",
        "meta.function.call.rust entity.name.function.rust",
        "meta.function-call.generic.python",
        "entity.name.function.support.go",
        "entity.name.function.definition",
        "entity.name.function.call"
      ],
      "settings": {
        "foreground": "#85EBFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "meta.definition.method entity.name.function",
        "meta.method.declaration entity.name.function",
        "meta.method.identifier.java entity.name.function.java",
        "meta.method-call.java entity.name.function.java",
        "meta.function.method.with-arguments.ruby entity.name.function.ruby",
        "meta.function.method.without-arguments.ruby entity.name.function.ruby",
        "entity.name.function.member",
        "entity.name.function.method",
        "support.function.method"
      ],
      "settings": {
        "foreground": "#AEC5FF"
      }
    },
    {
      "name": "Types, interfaces and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#8AFFDF"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#8AFFDF"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "storage.type.annotation",
        "storage.type.annotation entity.name.type",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#FFAACD"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "string.regex"
      ],
      "settings": {
        "foreground": "#FFCBB0"
      }
    },
    {
      "name": "Tag names",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FFAACD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#BDCDDF"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "meta.tag entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#FFF384"
      }
    },
    {
      "name": "Style selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element",
        "entity.name.tag.css",
        "entity.name.tag.scss",
        "entity.name.tag.less"
      ],
      "settings": {
        "foreground": "#B9B0FF"
      }
    },
    {
      "name": "Style values",
      "scope": [
        "support.constant.property-value",
        "constant.other.color",
        "support.constant.font-name",
        "support.constant.color",
        "constant.numeric.suffix"
      ],
      "settings": {
        "foreground": "#AEFFAB"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#8AFFDF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F3F7FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F3F7FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown deleted text",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#BDCDDF",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#FFF28A",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FFA3AC",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8AFFDF",
    "type": "#8AFFDF",
    "class": "#8AFFDF",
    "enum": "#8AFFDF",
    "interface": "#8AFFDF",
    "struct": "#8AFFDF",
    "typeParameter": "#8AFFDF",
    "parameter": "#FFF384",
    "property": "#FFF384",
    "enumMember": "#FFF384",
    "variable.readonly": "#FFF384",
    "function.declaration": {
      "foreground": "#85EBFF",
      "bold": true
    },
    "method": "#AEC5FF",
    "macro": "#85EBFF",
    "decorator": "#FFAACD"
  }
}
