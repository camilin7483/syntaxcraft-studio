    "editorHoverWidget.foreground": "#DFECDD",
    "editorHoverWidget.border": "#365142",
    "editorSuggestWidget.background": "#1E3125",
    "editorSuggestWidget.foreground": "#DFECDD",
    "editorSuggestWidget.border": "#365142",
    "editorSuggestWidget.selectedBackground": "#304B39",
    "editorSuggestWidget.highlightForeground": "#A2DEA4",
    "editorInlayHint.background": "#1E3125",
    "editorInlayHint.foreground": "#A4BBA9",
    "editorGutter.addedBackground": "#A8DDA7",
    "editorGutter.modifiedBackground": "#9CD7EB",
    "editorGutter.deletedBackground": "#F6A0A0",
    "editorOverviewRuler.addedForeground": "#A8DDA799",
    "editorOverviewRuler.modifiedForeground": "#9CD7EB99",
    "editorOverviewRuler.deletedForeground": "#F6A0A099",
    "editorOverviewRuler.errorForeground": "#F6A0A0",
    "editorOverviewRuler.warningForeground": "#EDCB79",
    "minimap.selectionHighlight": "#304B39",
    "minimapGutter.addedBackground": "#A8DDA7",
    "minimapGutter.modifiedBackground": "#9CD7EB",
    "minimapGutter.deletedBackground": "#F6A0A0",
    "diffEditor.insertedTextBackground": "#A8DDA73B",
    "diffEditor.removedTextBackground": "#F6A0A037",
    "diffEditor.insertedLineBackground": "#A8DDA71E",
    "diffEditor.removedLineBackground": "#F6A0A012",
    "diffEditor.diagonalFill": "#365142",
    "diffEditor.border": "#365142",
    "gitDecoration.addedResourceForeground": "#A8DDA7",
    "gitDecoration.modifiedResourceForeground": "#9CD7EB",
    "gitDecoration.deletedResourceForeground": "#F6A0A0",
    "gitDecoration.renamedResourceForeground": "#B3E8E4",
    "gitDecoration.untrackedResourceForeground": "#A8DDA7",
    "gitDecoration.ignoredResourceForeground": "#A4BBA9",
