    "editorHoverWidget.background": "#EDE5F1",
    "editorHoverWidget.foreground": "#3E334D",
    "editorHoverWidget.border": "#D6C4D8",
    "editorSuggestWidget.background": "#EDE5F1",
    "editorSuggestWidget.foreground": "#3E334D",
    "editorSuggestWidget.border": "#D6C4D8",
    "editorSuggestWidget.selectedBackground": "#E6D7EF",
    "editorSuggestWidget.highlightForeground": "#694586",
    "editorInlayHint.background": "#EDE5F1",
    "editorInlayHint.foreground": "#64566F",
    "editorGutter.addedBackground": "#356847",
    "editorGutter.modifiedBackground": "#325D90",
    "editorGutter.deletedBackground": "#A13756",
    "editorOverviewRuler.addedForeground": "#35684799",
    "editorOverviewRuler.modifiedForeground": "#325D9099",
    "editorOverviewRuler.deletedForeground": "#A1375699",
    "editorOverviewRuler.errorForeground": "#A13756",
    "editorOverviewRuler.warningForeground": "#805211",
    "minimap.selectionHighlight": "#E6D7EF",
    "minimapGutter.addedBackground": "#356847",
    "minimapGutter.modifiedBackground": "#325D90",
    "minimapGutter.deletedBackground": "#A13756",
    "diffEditor.insertedTextBackground": "#3568473B",
    "diffEditor.removedTextBackground": "#A1375637",
    "diffEditor.insertedLineBackground": "#3568471E",
    "diffEditor.removedLineBackground": "#A1375612",
    "diffEditor.diagonalFill": "#D6C4D8",
    "diffEditor.border": "#D6C4D8",
    "gitDecoration.addedResourceForeground": "#356847",
    "gitDecoration.modifiedResourceForeground": "#325D90",
    "gitDecoration.deletedResourceForeground": "#A13756",
    "gitDecoration.renamedResourceForeground": "#266464",
    "gitDecoration.untrackedResourceForeground": "#356847",
    "gitDecoration.ignoredResourceForeground": "#64566F",
    "gitDecoration.conflictingResourceForeground": "#805211",
    "gitDecoration.stageModifiedResourceForeground": "#325D90",
    "gitDecoration.stageDeletedResourceForeground": "#A13756",
